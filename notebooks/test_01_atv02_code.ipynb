import numpy as np
from scipy.signal import convolve2d

# notebooks/test_01_atv02_code.ipynb


def test_convolution():
    # Matrizes fornecidas
    f = (1 / 9) * np.array([
        [1, 1, 1],
        [1, 1, 1],
        [1, 1, 1]
    ])

    h = np.array([
        [-1, 0, 1],
        [-1, 0, 1],
        [-1, 0, 1]
    ])

    # Resultado esperado
    expected_result = np.array([
        [-0.11111111, -0.22222222,  0.0,  0.22222222,  0.11111111],
        [-0.22222222, -0.44444444,  0.0,  0.44444444,  0.22222222],
        [-0.33333333, -0.66666667,  0.0,  0.66666667,  0.33333333],
        [-0.22222222, -0.44444444,  0.0,  0.44444444,  0.22222222],
        [-0.11111111, -0.22222222,  0.0,  0.22222222,  0.11111111]
    ])

    # Aplica a convolução 2D
    result = convolve2d(f, h, mode='full')

    # Verifica se o resultado é igual ao esperado
    assert np.allclose(result, expected_result), f"Resultado inesperado: {result}"

# Run the test
test_convolution()